{
  "profile_version": 1,
  "id": "minimal",
  "name": "Minimal",
  "description": "Safe recommended baseline (~28 tweaks): removes promoted bloatware apps, blocks BIOS/Cloud bloat injection, enables Win32 long paths, speeds up Explorer folders, and shows file extensions.",
  "bundles": [
    "bing_lock_and_suggestions_disable",
    "disable_consumer_features_cloud_content",
    "settings_365_ads_and_home_disable",
    "bing_search_disable",
    "store_search_suggestions_disable",
    "taskbar_hide_chat_meetnow",
    "taskbar_enable_end_task",
    "explorer_show_extensions_and_hidden",
    "explorer_launch_to_this_pc",
    "explorer_hide_duplicate_removable_drives",
    "enable_win32_long_paths",
    "disable_explorer_auto_folder_discovery",
    "stop_edge_pdf_hijack",
    "desktop_spotlight_disable",
    "alt_tab_hide_edge_tabs",
    "always_show_scrollbars",
    "wu_no_auto_reboot_logged_on",
    "disable_device_auto_app_download",
    "disable_wpbt_bios_injection",
    "block_razer_logitech_auto_install",
    "remove_clipchamp",
    "remove_bing_news_weather",
    "remove_bing_suite_extra",
    "remove_solitaire_casual",
    "remove_cortana_and_tips",
    "remove_3d_and_mixed_reality",
    "remove_office_hub_and_companions",
    "remove_third_party_sponsored_bloat"
  ]
}
